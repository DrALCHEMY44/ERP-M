rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed legacy data model
    // ===============================================================
    // users/{uid}: tenantId, businessId, email, role and fullName. This
    // document contains PII and authorization attributes. It is read-only
    // migration data; SQL Connect is authoritative.
    // activity_logs, notifications, settings and all other collections are
    // server-managed or retired. Client access is denied.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isValidLegacyUser(data) {
      return data.keys().hasAll(['tenantId', 'businessId', 'email', 'role'])
        && data.keys().hasOnly(['tenantId', 'businessId', 'email', 'role', 'fullName'])
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 200
        && data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 200
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.role is string && data.role in ['Platform Super Admin', 'Business Owner', 'Manager', 'Accountant', 'HR Officer', 'Staff', 'Viewer']
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 160));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) && isValidLegacyUser(resource.data);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
