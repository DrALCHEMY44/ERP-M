{
  "name": "smart-erp-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrALCHEMY44/ERP-M.git"
  },
  "scripts": {
    "dev": "next dev  -p 9002",
    "build": "cross-env NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test e2e/public.spec.ts",
    "test:e2e:smoke": "playwright test e2e/authenticated.spec.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:e2e": "next dev --webpack -H 127.0.0.1 -p 9010",
    "env:check": "tsx --env-file=.env scripts/validate-environment.ts",
    "demo:seed": "node --env-file=.env scripts/seed-demo.mjs",
    "db:migrate:neon": "node --env-file=.env scripts/apply-neon-migrations.mjs",
    "db:reset:neon": "node --env-file=.env scripts/reset-neon-data.mjs",
    "storage:reset": "node --env-file=.env scripts/reset-object-storage.mjs",
    "db:verify:neon": "node --env-file=.env scripts/verify-neon.mjs",
    "db:verify:modules": "node --env-file=.env scripts/verify-enterprise-modules.mjs",
    "db:migrate:dataconnect": "node --env-file=.env scripts/backfill-firebase-to-neon.mjs",
    "db:inspect:outbox": "node --env-file=.env scripts/reconcile-outbox.mjs",
    "auth:migrate:neon": "node --env-file=.env scripts/migrate-users-to-neon-auth.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
