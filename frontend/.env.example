# Neon Auth is proxied through /api/auth so browser sessions remain HttpOnly.
# Copy the branch-specific endpoint from Neon Console > Auth > Configuration.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.eu-central-1.aws.neon.tech/neondb/auth
# Generate independently with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example

# Allowed HTTPS origins, comma-separated. Include the deployed web origin.
ALLOWED_ORIGINS=https://your-vercel-domain.example

# Private Neon PostgreSQL configuration (the sole relational system of record)
DATABASE_URL=
EXPECTED_DATABASE_HOST=
# Maximum per-instance connections used only for interactive transactions (1-20)
NEON_POOL_MAX=5

# Private S3-compatible object storage configuration
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Private OpenRouter and abuse-control configuration
OPENROUTER_API_KEY=
# Optional comma-separated preferred models; secure current free defaults remain as fallbacks.
OPENROUTER_MODELS=
# Keep provider collection denied. ZDR requires compatible endpoints/account privacy settings.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_REQUIRE_ZDR=false
RATE_LIMIT_SECRET=
AI_RETENTION_DAYS=30
AI_INSIGHT_CACHE_MINUTES=15

# Private Vercel Cron / reconciliation secret (minimum 32 random characters)
CRON_SECRET=

# Required only by guarded migration/backfill/demo scripts
DEMO_MODE_CONFIRMATION=
MIGRATION_CONFIRMATION=
NEON_MIGRATION_CONFIRMATION=
NEON_AUTH_USER_MIGRATION_CONFIRMATION=
# Source-only values used once by db:migrate:dataconnect before Cloud SQL is retired
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SOURCE_FIREBASE_PROJECT_ID=
SOURCE_FIREBASE_DATACONNECT_LOCATION=us-east4
SOURCE_FIREBASE_DATACONNECT_SERVICE_ID=
SOURCE_FIREBASE_DATACONNECT_CONNECTOR_ID=example
DEMO_OWNER_A_UID=
DEMO_OWNER_A_EMAIL=
DEMO_OWNER_B_UID=
DEMO_OWNER_B_EMAIL=
DEMO_EMPLOYEE_UID=
DEMO_EMPLOYEE_EMAIL=
DEMO_EMPLOYEE_ACCESS_CODE=
