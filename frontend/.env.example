# Public browser configuration (Firebase web app values are public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example

# Allowed HTTPS origins, comma-separated. Include the deployed web origin.
ALLOWED_ORIGINS=https://your-vercel-domain.example

# Private Firebase Admin configuration. On Google-managed runtimes, Application
# Default Credentials may be used; Vercel requires both values below.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Private Firebase Data Connect configuration for the dedicated demo project
FIREBASE_DATACONNECT_LOCATION=us-east4
FIREBASE_DATACONNECT_SERVICE_ID=
FIREBASE_DATACONNECT_CONNECTOR_ID=example

# Private Neon PostgreSQL configuration
DATABASE_URL=

# Private S3-compatible object storage configuration
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Private OpenRouter and abuse-control configuration
OPENROUTER_API_KEY=
RATE_LIMIT_SECRET=
AI_RETENTION_DAYS=30

# Private Vercel Cron / reconciliation secret (minimum 32 random characters)
CRON_SECRET=

# Required only by guarded migration/backfill/demo scripts
DEMO_MODE_CONFIRMATION=
EXPECTED_DATABASE_HOST=
EXPECTED_FIREBASE_PROJECT_ID=
DEMO_OWNER_A_UID=
DEMO_OWNER_A_EMAIL=
DEMO_OWNER_B_UID=
DEMO_OWNER_B_EMAIL=
DEMO_EMPLOYEE_UID=
DEMO_EMPLOYEE_EMAIL=
